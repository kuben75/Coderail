#!/bin/sh
# commit-msg: Conventional Commits (docs/10-git-workflow.md).
set -eu
msg_file="$1"
subject=$(sed -n '/^[^#]/{p;q;}' "$msg_file")

# Wyjątki generowane przez gita
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|perf|refactor|test|docs|build|ci|chore|revert)(\([a-z0-9/._-]+\))?!?: [^ ].{0,71}$'
if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<MSG

✖ commit-msg: tytuł nie jest w formacie Conventional Commits
  Otrzymano: "$subject"
  Oczekiwano: <typ>(<zakres>): <opis w trybie rozkazującym, ≤72 znaki>
  Typy: feat fix perf refactor test docs build ci chore revert
  Przykład: feat(rules/no-secrets): detect hardcoded Anthropic keys

MSG
  exit 1
fi

case "$subject" in
  *.) printf '\n✖ commit-msg: tytuł nie kończy się kropką\n\n' >&2; exit 1 ;;
esac
exit 0
