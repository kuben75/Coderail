root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[tests/fixtures/**]
# Fixture'y to materiał testowy 1:1 — edytor nie może ich "poprawiać"
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
